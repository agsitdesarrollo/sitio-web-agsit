---
import FinalContactSection from '../final-contact/FinalContactSection.astro';
import ServiceSlidesController from '../service-slides/ServiceSlidesController.astro';
import type { ContactCopy } from '../../data/contact';
import type { TechnologySolutionsContent } from '../../data/technologySolutions';

type Props = {
  content: TechnologySolutionsContent;
  contactCopy: ContactCopy;
  capabilityLinkCodes?: string[];
};

const { content, contactCopy, capabilityLinkCodes } = Astro.props;
const shouldShowCapabilityLink = (code: string) => capabilityLinkCodes?.includes(code) ?? false;
const isEnglishPage = Astro.url.pathname.startsWith('/en/');
const mobileCapabilityOverrides: Record<string, { title: string; copy: string }> = isEnglishPage
  ? {}
  : {
      BIZ: {
        title: 'Plataformas Empresariales Inteligentes',
        copy: 'Implementamos plataformas que centralizan la información, optimizan procesos y facilitan la colaboración entre áreas.',
      },
      SW: {
        title: 'Desarrollo de Software a la Medida',
        copy: 'Desarrollamos software a la medida que optimiza la operación y responde a las necesidades de tu empresa.',
      },
    };
const mobileCapabilityCta = isEnglishPage ? 'Learn more' : 'Conocer servicio';
const capabilityPages = Array.from(
  { length: Math.ceil(content.capabilities.items.length / 4) },
  (_, pageIndex) => content.capabilities.items.slice(pageIndex * 4, pageIndex * 4 + 4),
);
---

<main class="technology-page">
  <section class="technology-hero" aria-labelledby="technology-hero-title">
    <video class="technology-hero-video" aria-hidden="true" autoplay muted loop playsinline preload="metadata">
      <source src="/assets/binary-wave-bg.webm" type="video/webm" />
      <source src="/assets/binary-wave-bg.mp4" type="video/mp4" />
    </video>

    <div class="technology-hero-content">
      <p class="technology-eyebrow">{content.hero.eyebrow}</p>
      <h1 id="technology-hero-title">
        {content.hero.title.map((line) => <span>{line}</span>)}
      </h1>
      <p>{content.hero.copy}</p>
      <div class="technology-actions">
        <button type="button" data-contact-trigger>{content.hero.primaryCta}</button>
      </div>
    </div>

  </section>

  <section class="technology-method" aria-labelledby="technology-method-title">
    <div class="technology-section-heading">
      <p class="technology-eyebrow">{content.method.eyebrow}</p>
      <h2 id="technology-method-title">{content.method.title}</h2>
      <p>{content.method.copy}</p>
    </div>

    <div class="technology-method-map" aria-label="Método de trabajo AGSIT">
      <div class="technology-method-path" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      {
        content.method.steps.map((step, index) => (
          <article class={`technology-method-step technology-method-step-${index + 1}`}>
            <span class="technology-step-index">{String(index + 1).padStart(2, '0')}</span>
            <div class="technology-step-node" aria-hidden="true">
              <span></span>
            </div>
            <p class="technology-step-label">{step.label}</p>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
            <strong>{step.outcome}</strong>
          </article>
        ))
      }
    </div>
  </section>

  <section id="capacidades" class="technology-capabilities" aria-labelledby="technology-capabilities-title">
    <div
      class="technology-capabilities-stage"
      style={`--technology-capability-panel-count: ${capabilityPages.length + 1}`}
    >
      <div class="technology-capabilities-panel technology-capabilities-panel-intro">
        <div class="technology-capabilities-intro">
          <p class="technology-eyebrow js-technology-capabilities-intro-fade">{content.capabilities.eyebrow}</p>
          <h2 id="technology-capabilities-title" class="js-technology-capabilities-intro-fade">
            {content.capabilities.title}
          </h2>
          <p class="js-technology-capabilities-intro-fade">{content.capabilities.copy}</p>
        </div>
      </div>

      {
        capabilityPages.map((items, pageIndex) => (
          <div class="technology-capabilities-panel technology-capabilities-panel-grid" data-capability-page={pageIndex + 1}>
            <div class="technology-capability-grid" data-capability-count={items.length}>
              {
                items.map((item) => {
                  const mobileOverride = mobileCapabilityOverrides[item.code];
                  const hasCapabilityLink = shouldShowCapabilityLink(item.code) && Boolean(item.href);

                  return (
                    <article class="technology-capability">
                      <div class="technology-capability-content">
                        <span class="technology-capability-code">{item.label ?? item.code}</span>
                        <h3>
                          <span class:list={{ 'technology-capability-default-copy': Boolean(mobileOverride) }}>{item.title}</span>
                          {mobileOverride && <span class="technology-capability-mobile-copy">{mobileOverride.title}</span>}
                        </h3>
                        <p>
                          <span class:list={{ 'technology-capability-default-copy': Boolean(mobileOverride) }}>{item.copy}</span>
                          {mobileOverride && <span class="technology-capability-mobile-copy">{mobileOverride.copy}</span>}
                        </p>
                      </div>
                      <div class="technology-capability-action" aria-hidden={hasCapabilityLink ? undefined : 'true'}>
                        {hasCapabilityLink && (
                          <a class="technology-capability-link" href={item.href}>
                            <span class="technology-capability-link-text technology-capability-desktop-cta">{item.cta}</span>
                            <span class="technology-capability-link-text technology-capability-mobile-cta">{mobileCapabilityCta}</span>
                            <span class="technology-capability-arrow" aria-hidden="true"></span>
                          </a>
                        )}
                        </div>
                    </article>
                  );
                })
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="beneficios-negocio" class="technology-benefits" aria-labelledby="technology-benefits-title">
    <div class="technology-section-heading">
      <p class="technology-eyebrow">{content.benefits.eyebrow}</p>
      <h2 id="technology-benefits-title">{content.benefits.title}</h2>
      <p>{content.benefits.copy}</p>
    </div>

    <div class="technology-benefit-grid">
      {
        content.benefits.items.map((benefit) => (
          <article class="technology-benefit-card">
            <span>{benefit.value}</span>
            <h3>{benefit.title}</h3>
            <p>{benefit.copy}</p>
          </article>
        ))
      }
    </div>
  </section>

  <FinalContactSection copy={contactCopy} />
  <ServiceSlidesController />
</main>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const getTechnologyNavOffset = () =>
    Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--app-track-offset')) || 0;

  const getTechnologyViewportHeight = () => {
    const stableViewportHeight = Number.parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--app-stable-vh'),
    );

    const viewportHeight = Number.isFinite(stableViewportHeight) && stableViewportHeight > 0
      ? stableViewportHeight
      : window.innerHeight;

    return Math.max(1, viewportHeight);
  };

  const setupTechnologyMethodScroll = () => {
    const root = document.querySelector('.technology-page');

    if (!root || root.hasAttribute('data-technology-method-ready')) return;

    const method = root.querySelector('.technology-method');
    const steps = gsap.utils.toArray<HTMLElement>('.technology-method-step', method);

    if (!(method instanceof HTMLElement) || steps.length === 0) return;

    root.setAttribute('data-technology-method-ready', 'true');

    const matchMedia = gsap.matchMedia();
    const getSequenceEnd = (multiplier: number) => `+=${Math.round(getTechnologyViewportHeight() * multiplier)}`;
    const getPinStart = () => `top top+=${getTechnologyNavOffset()}`;

    matchMedia.add('(prefers-reduced-motion: no-preference) and (min-width: 680px) and (min-height: 521px)', () => {
      method.classList.add('is-scroll-sequence');
      gsap.set(steps, { autoAlpha: 0, y: 56 });

      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          id: 'technology-method-sequence-desktop',
          trigger: method,
          start: getPinStart,
          end: () => getSequenceEnd(steps.length * 0.72),
          pin: true,
          pinSpacing: true,
          scrub: 0.65,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      steps.forEach((step) => {
        timeline
          .to(step, { autoAlpha: 1, y: 0, duration: 1, ease: 'power2.out' })
          .to({}, { duration: 0.22 });
      });

      return () => {
        timeline.kill();
        method.classList.remove('is-scroll-sequence');
        gsap.set(steps, { clearProps: 'all' });
      };
    });

    matchMedia.add(
      [
        '(prefers-reduced-motion: no-preference) and (max-width: 679px)',
        '(prefers-reduced-motion: no-preference) and (max-width: 1024px) and (max-height: 520px)',
      ].join(', '),
      () => {
      method.classList.add('is-scroll-sequence', 'is-mobile-sequence');
      gsap.set(steps, { autoAlpha: 0, y: 46 });

      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          id: 'technology-method-sequence-mobile',
          trigger: method,
          start: getPinStart,
          end: () => getSequenceEnd(steps.length * 0.86),
          pin: true,
          pinSpacing: true,
          scrub: 0.7,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      timeline.to(steps[0], { autoAlpha: 1, y: 0, duration: 0.65, ease: 'power2.out' }).to({}, { duration: 0.35 });

      steps.slice(1).forEach((step, index) => {
        const previousStep = steps[index];
        const label = `technology-step-${index + 2}`;

        timeline
          .add(label)
          .to(previousStep, { autoAlpha: 0, y: -22, duration: 0.45, ease: 'power1.in' }, label)
          .fromTo(step, { autoAlpha: 0, y: 46 }, { autoAlpha: 1, y: 0, duration: 0.65, ease: 'power2.out' }, label)
          .to({}, { duration: 0.35 });
      });

      return () => {
        timeline.kill();
        method.classList.remove('is-scroll-sequence', 'is-mobile-sequence');
        gsap.set(steps, { clearProps: 'all' });
      };
      },
    );

    window.addEventListener('agsit:viewport-change', () => ScrollTrigger.refresh());
  };

  const setupTechnologyCapabilitiesScroll = () => {
    const root = document.querySelector('.technology-page');

    if (!root || root.hasAttribute('data-technology-capabilities-ready')) return;

    const capabilities = root.querySelector('.technology-capabilities');
    const stage = root.querySelector('.technology-capabilities-stage');
    const introItems = gsap.utils.toArray<HTMLElement>('.js-technology-capabilities-intro-fade', capabilities);
    const gridPanels = gsap.utils.toArray<HTMLElement>('.technology-capabilities-panel-grid', capabilities);
    const cardGroups = gridPanels.map((panel) => gsap.utils.toArray<HTMLElement>('.technology-capability', panel));
    const cards = cardGroups.flat();
    const mobileCardGroups = Array.from(
      { length: Math.ceil(cards.length / 2) },
      (_, groupIndex) => cards.slice(groupIndex * 2, groupIndex * 2 + 2),
    );

    if (!(capabilities instanceof HTMLElement) || !(stage instanceof HTMLElement) || cards.length === 0 || gridPanels.length === 0) return;

    root.setAttribute('data-technology-capabilities-ready', 'true');

    const matchMedia = gsap.matchMedia();
    const getDesktopSequenceEnd = () => `+=${Math.round(getTechnologyViewportHeight() * gridPanels.length)}`;
    const getMobileSequenceEnd = () => `+=${Math.round(getTechnologyViewportHeight() * (mobileCardGroups.length * 0.92 + 2.4))}`;
    const getPinStart = () => `top top+=${getTechnologyNavOffset()}`;
    const getStagePosition = (panelIndex: number) =>
      -((panelIndex / (gridPanels.length + 1)) * 100);
    const getPanelIndexForMobileGroup = (group: HTMLElement[]) => {
      const firstCard = group[0];
      if (!firstCard) return 0;

      return gridPanels.findIndex((panel) => panel.contains(firstCard)) + 1;
    };

    matchMedia.add('(prefers-reduced-motion: no-preference) and (min-width: 680px) and (min-height: 521px)', () => {
      capabilities.classList.add('is-horizontal-sequence');
      gsap.set(stage, { xPercent: 0 });
      gsap.set(introItems, { autoAlpha: 1, y: 0 });
      gsap.set(cards, { autoAlpha: 0, y: 38, scale: 0.96 });

      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          id: 'technology-capabilities-sequence',
          trigger: capabilities,
          start: getPinStart,
          end: getDesktopSequenceEnd,
          pin: true,
          pinSpacing: true,
          scrub: 0.75,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      cardGroups.forEach((group, pageIndex) => {
        timeline
          .to(stage, { xPercent: getStagePosition(pageIndex + 1), duration: 0.38, ease: 'power1.inOut' })
          .to(group, { autoAlpha: 1, y: 0, scale: 1, duration: 0.3, stagger: 0.02, ease: 'power2.out' })
          .to({}, { duration: 0.22 });
      });

      return () => {
        timeline.kill();
        capabilities.classList.remove('is-horizontal-sequence');
        gsap.set(stage, { clearProps: 'all' });
        gsap.set(introItems, { clearProps: 'all' });
        gsap.set(cards, { clearProps: 'all' });
      };
    });

    matchMedia.add(
      [
        '(prefers-reduced-motion: no-preference) and (max-width: 679px)',
        '(prefers-reduced-motion: no-preference) and (max-width: 1024px) and (max-height: 520px)',
      ].join(', '),
      () => {
        capabilities.classList.add('is-mobile-horizontal-sequence');
        gsap.set(capabilities, { padding: 0 });
        gsap.set(stage, { xPercent: 0 });
        gsap.set(introItems, { autoAlpha: 1, y: 0 });
        gsap.set(cards, { autoAlpha: 0, yPercent: 18, scale: 0.98 });

        const timeline = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            id: 'technology-capabilities-sequence-mobile',
            trigger: capabilities,
            start: getPinStart,
            end: getMobileSequenceEnd,
            pin: true,
            pinSpacing: true,
            scrub: 0.55,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });

        mobileCardGroups.forEach((group, groupIndex) => {
          const previousGroup = mobileCardGroups[groupIndex - 1];
          const panelIndex = getPanelIndexForMobileGroup(group);
          const previousPanelIndex = previousGroup ? getPanelIndexForMobileGroup(previousGroup) : 0;

          if (!previousGroup || panelIndex !== previousPanelIndex) {
            timeline.to(stage, { xPercent: getStagePosition(panelIndex), duration: 0.22 });

            if (previousGroup) {
              timeline.to(previousGroup, { autoAlpha: 0, yPercent: -18, duration: 0.22 }, '<');
            }

            timeline
              .fromTo(
                group,
                { autoAlpha: 0, yPercent: 18, scale: 0.98 },
                { autoAlpha: 1, yPercent: 0, scale: 1, duration: 0.55, stagger: 0.06, immediateRender: false },
              )
              .to({}, { duration: 0.23 });
            return;
          }

          timeline
            .to(previousGroup, { autoAlpha: 0, yPercent: -18, duration: 0.55 })
            .fromTo(
              group,
              { autoAlpha: 0, yPercent: 18, scale: 0.98 },
              { autoAlpha: 1, yPercent: 0, scale: 1, duration: 0.55, stagger: 0.06, immediateRender: false },
              '<',
            )
            .to({}, { duration: 0.45 });
        });

        return () => {
          timeline.kill();
          capabilities.classList.remove('is-mobile-horizontal-sequence');
          gsap.set(capabilities, { clearProps: 'padding' });
          gsap.set(stage, { clearProps: 'all' });
          gsap.set(introItems, { clearProps: 'all' });
          gsap.set(cards, { clearProps: 'all' });
        };
      },
    );
  };

  const setupTechnologyReveal = () => {
    const root = document.querySelector('.technology-page');

    if (!root || root.hasAttribute('data-technology-ready')) return;

    root.setAttribute('data-technology-ready', 'true');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = Array.from(
      root.querySelectorAll(
        '.technology-hero-content, .technology-section-heading, .technology-benefit-grid',
      ),
    ).filter((item) => item instanceof HTMLElement);

    items.forEach((item, index) => {
      item.setAttribute('data-technology-reveal', '');
      item.style.setProperty('--technology-delay', `${Math.min(index % 7, 6) * 65}ms`);
    });

    if (reduceMotion || !('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      {
        rootMargin: '0px 0px -12% 0px',
        threshold: 0.12,
      },
    );

    items.forEach((item) => observer.observe(item));
  };

  const setupTechnologyPage = () => {
    setupTechnologyMethodScroll();
    setupTechnologyCapabilitiesScroll();
    setupTechnologyReveal();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTechnologyPage, { once: true });
  } else {
    setupTechnologyPage();
  }
</script>
