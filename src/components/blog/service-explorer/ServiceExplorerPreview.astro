---
import ServiceExplorer from './ServiceExplorer.astro';
import { getGrowthServiceExplorer } from '../../../data/blog/growthServiceExplorer';
import type { SupportedLang } from '../../../i18n/ui';

type Props = { lang: SupportedLang };
const { lang } = Astro.props;
const isEnglish = lang === 'en';
const title = isEnglish ? 'Blog service grid preview' : 'Vista previa de servicios para el blog';
const ctaHref = isEnglish ? '/en/digital-marketing/growth-marketing-and-digital-strategy/#contacto' : '/marketing-digital/growth-marketing-y-estrategia-digital/#contacto';
---
<!doctype html>
<html lang={isEnglish ? 'en' : 'es-MX'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | AGSIT</title>
    <link rel="icon" href="/AGSIT-Logo-512x512-2-150x150.png" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <header class="bse-preview-header">
      <h1>{title}</h1>
      <nav aria-label={isEnglish ? 'Preview language' : 'Idioma de la vista previa'}>
        <a href="/vista-previa/servicios-blog/es/" lang="es" aria-current={!isEnglish ? 'page' : undefined}>Español</a>
        <a href="/vista-previa/servicios-blog/en/" lang="en" aria-current={isEnglish ? 'page' : undefined}>English</a>
      </nav>
    </header>
    <main><ServiceExplorer content={getGrowthServiceExplorer(lang)} ctaHref={ctaHref} /></main>
  </body>
</html>
<style>
  :global(body) { margin: 0; background: #fff; }
  .bse-preview-header { padding: 24px clamp(20px,5vw,72px); background: #08152b; color: #f6fafe; font: 500 1rem/1.5 'Inter',sans-serif; }
  h1 { margin: 0 0 16px; font-size: 1rem; font-weight: 600; }
  nav { display: flex; gap: 24px; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: #8be2ff; text-underline-offset: 5px; }
  a[aria-current] { color: #fff; text-decoration-thickness: 2px; }
  a:focus-visible { outline: 3px solid #8be2ff; outline-offset: 4px; }
</style>
