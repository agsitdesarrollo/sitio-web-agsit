---
import FinalContactSection from '../final-contact/FinalContactSection.astro';
import ServiceSlidesController from '../service-slides/ServiceSlidesController.astro';
import type { ContactCopy } from '../../data/contact';
import type { CrmAdministrationContent } from '../../data/crmAdministration';

type Props = {
  content: CrmAdministrationContent;
  contactCopy: ContactCopy;
};

const { content, contactCopy } = Astro.props;
---

<main class="crm-platform-page" data-service-touch-threshold="22">
  <section class="crm-platform-hero" aria-labelledby="crm-platform-title">
    <div class="crm-shell crm-platform-hero-layout">
      <div class="crm-platform-hero-copy">
        <p class="crm-kicker">{content.hero.eyebrow}</p>
        <h1 id="crm-platform-title">
          {content.hero.title}
          <em>{content.hero.titleAccent}</em>
        </h1>
        <p class="crm-platform-lead">{content.hero.copy}</p>
        <div class="crm-platform-actions">
          <button type="button" data-contact-trigger>{content.hero.primaryCta}</button>
        </div>
      </div>

      <div class="crm-hero-visual-column">
        <figure class="crm-hero-visual" role="img" aria-label={content.hero.visualAlt}>
          <video
            class="crm-hero-video"
            data-crm-hero-video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/assets/hero-crm-example.png"
            aria-hidden="true"
            tabindex="-1"
          >
            <source src="/assets/binary-wave-bg.mp4" type="video/mp4" />
          </video>
        </figure>
        <nav class="crm-hero-pathways" aria-label={content.hero.pathwaysLabel}>
          {content.hero.pathways.map((pathway) => (
            <a href={pathway.href}>
              <span>{pathway.label}</span>
              <span class="crm-hero-pathway-arrow" aria-hidden="true">↘</span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section id="plataforma" class="crm-connection-story" aria-labelledby="crm-connection-title">
    <div class="crm-shell crm-connection-layout">
      <div class="crm-section-intro crm-connection-copy">
        <p class="crm-kicker">{content.convergence.eyebrow}</p>
        <h2 id="crm-connection-title">{content.convergence.title}</h2>
        <p>{content.convergence.copy}</p>
      </div>
      <div class="crm-connection-visual crm-replacement-carousel" data-replacement-carousel>
        <p class="crm-replacement-label">{content.convergence.replacementLabel}</p>
        <div class="crm-replacement-viewport">
          <div class="crm-replacement-track">
            <ul class="crm-replacement-list">
              {content.convergence.replacements.map((replacement) => (
                <li>
                  <button
                    type="button"
                    class="crm-replacement-logo"
                    data-replacement-trigger
                    data-replacement-name={replacement.name}
                    data-replacement-copy={replacement.tooltip}
                    aria-label={`${replacement.name}. ${replacement.tooltip}`}
                    aria-describedby="crm-replacement-tooltip"
                  >
                    <img
                      src={replacement.logo}
                      alt=""
                      width="144"
                      height="144"
                      loading="lazy"
                      decoding="async"
                    />
                  </button>
                </li>
              ))}
            </ul>

            <ul class="crm-replacement-list" aria-hidden="true">
              {content.convergence.replacements.map((replacement) => (
                <li>
                  <span class="crm-replacement-logo crm-replacement-logo-clone">
                    <img
                      src={replacement.logo}
                      alt=""
                      width="144"
                      height="144"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div
          id="crm-replacement-tooltip"
          class="crm-replacement-tooltip"
          data-replacement-tooltip
          role="tooltip"
          aria-live="polite"
          aria-atomic="true"
          aria-hidden="true"
        >
          <strong data-replacement-tooltip-name></strong>
          <span data-replacement-tooltip-copy></span>
        </div>
      </div>
    </div>
  </section>

  <section class="crm-pillars-intro" aria-labelledby="crm-pillars-title">
    <div class="crm-shell crm-pillars-intro-content">
      <p class="crm-kicker">{content.pillars.eyebrow}</p>
      <h2 id="crm-pillars-title">{content.pillars.title}</h2>
      <p>{content.pillars.copy}</p>
    </div>

    <div class="crm-pillars-scroll-bridge" aria-hidden="true">
      <span class="crm-pillars-scroll-cue">
        <svg viewBox="0 0 32 32" focusable="false">
          <path d="m9 5 7 7 7-7" />
          <path d="m9 12 7 7 7-7" />
          <path d="m9 19 7 7 7-7" />
        </svg>
      </span>
      <span class="crm-pillars-scroll-line">
        <span class="crm-pillars-scroll-line-progress" data-crm-intro-bridge-progress></span>
      </span>
      <svg
        class="crm-pillars-scroll-curve"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        focusable="false"
      >
        <defs>
          <clipPath id="crm-pillars-scroll-curve-clip">
            <rect
              data-crm-intro-curve-progress
              x="0"
              y="0"
              width="100"
              height="0"
            />
          </clipPath>
        </defs>
        <path class="crm-pillars-scroll-curve-base" d="M100 0V18C100 58 0 62 0 100" />
        <path
          class="crm-pillars-scroll-curve-progress"
          d="M100 0V18C100 58 0 62 0 100"
          clip-path="url(#crm-pillars-scroll-curve-clip)"
        />
      </svg>
    </div>
  </section>

  {content.pillars.items.map((item, index) => {
    const itemNumber = index + 1;
    const startX = itemNumber === 1 ? 50 : itemNumber % 2 === 0 ? 47 : 52;
    const endX = itemNumber % 2 === 0 ? 52 : 47;
    const pathData = `M${startX} 0V50C${startX} 68 ${endX} 78 ${endX} 100`;
    const maskId = `crm-pillar-mask-${itemNumber}`;
    const itemId = `crm-pillar-item-${itemNumber}`;

    return (
      <section
        id={item.anchor}
        class:list={[
          'crm-pillar-step',
          `crm-pillar-step-${itemNumber}`,
          {
            'crm-pillar-step-odd': itemNumber % 2 === 1,
            'crm-pillar-step-even': itemNumber % 2 === 0,
          },
        ]}
        aria-labelledby={itemId}
      >
        <div class="crm-pillar-path-lane" aria-hidden="true">
          <svg class="crm-pillar-path" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs>
              <clipPath id={maskId}>
                <rect
                  class="crm-pillar-path-fill"
                  data-pillar-fill-stop="50"
                  x="0"
                  y="0"
                  width="100"
                  height="0"
                />
              </clipPath>
            </defs>
            <path class="crm-pillar-path-base" d={pathData} />
            <path class="crm-pillar-path-progress" d={pathData} clip-path={`url(#${maskId})`} />
          </svg>
          <span class="crm-pillar-path-marker" style={`--crm-marker-x: ${startX}%`}></span>
        </div>

        <div class="crm-shell crm-pillar-step-shell">
          <article class="crm-pillar-card">
            <figure class="crm-pillar-media" aria-hidden="true">
              <img src={item.image} alt="" loading="lazy" decoding="async" />
            </figure>
            <div class="crm-pillar-card-copy">
              <span class="crm-pillar-index">{item.eyebrow}</span>
              <h3 id={itemId}>{item.title}</h3>
              <p>{item.copy}</p>
              <small>{item.detail}</small>
            </div>
          </article>
        </div>
      </section>
    );
  })}

  <FinalContactSection copy={contactCopy} />
  <ServiceSlidesController />
</main>

<script>
  const initializeHeroVideos = () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLVideoElement>('[data-crm-hero-video]').forEach((video) => {
      if (reduceMotion) {
        video.pause();
        video.currentTime = 0;
        return;
      }

      void video.play().catch(() => {
        // The poster remains visible when the browser blocks autoplay.
      });
    });
  };

  const initializeReplacementCarousels = () => {
    document.querySelectorAll<HTMLElement>('[data-replacement-carousel]').forEach((carousel) => {
      if (carousel.dataset.replacementReady === 'true') return;
      carousel.dataset.replacementReady = 'true';

      const tooltip = carousel.querySelector<HTMLElement>('[data-replacement-tooltip]');
      const tooltipName = carousel.querySelector<HTMLElement>('[data-replacement-tooltip-name]');
      const tooltipCopy = carousel.querySelector<HTMLElement>('[data-replacement-tooltip-copy]');
      const triggers = carousel.querySelectorAll<HTMLButtonElement>('[data-replacement-trigger]');

      if (!tooltip || !tooltipName || !tooltipCopy) return;

      const hideTooltip = () => {
        carousel.classList.remove('is-tooltip-visible');
        tooltip.setAttribute('aria-hidden', 'true');
        tooltipName.textContent = '';
        tooltipCopy.textContent = '';
      };

      const resetInteraction = () => {
        hideTooltip();
        carousel.classList.remove('is-keyboard-active', 'is-touch-active');
      };

      const showTooltip = (trigger: HTMLButtonElement) => {
        tooltipName.textContent = trigger.dataset.replacementName ?? '';
        tooltipCopy.textContent = trigger.dataset.replacementCopy ?? '';
        tooltip.setAttribute('aria-hidden', 'false');
        carousel.classList.add('is-tooltip-visible');
      };

      triggers.forEach((trigger) => {
        let pointerType = '';

        trigger.addEventListener('pointerdown', (event) => {
          pointerType = event.pointerType;
          if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
          carousel.classList.add('is-touch-active');
          showTooltip(trigger);
        });
        trigger.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') showTooltip(trigger);
        });
        trigger.addEventListener('pointerleave', (event) => {
          if (event.pointerType !== 'mouse') return;
          const hasKeyboardFocus =
            carousel.classList.contains('is-keyboard-active') && document.activeElement === trigger;
          if (!hasKeyboardFocus) hideTooltip();
        });
        trigger.addEventListener('focus', () => {
          if (pointerType === 'mouse' || pointerType === 'touch' || pointerType === 'pen') return;
          carousel.classList.add('is-keyboard-active');
          showTooltip(trigger);
        });
        trigger.addEventListener('blur', () => {
          pointerType = '';
          carousel.classList.remove('is-keyboard-active');
          if (!carousel.classList.contains('is-touch-active')) hideTooltip();
        });
        trigger.addEventListener('click', () => {
          if (pointerType !== 'touch' && pointerType !== 'pen') return;
          carousel.classList.add('is-touch-active');
          showTooltip(trigger);
        });
        trigger.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          resetInteraction();
          trigger.blur();
        });
      });

      document.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Node && !carousel.contains(event.target)) resetInteraction();
      });
    });
  };

  initializeHeroVideos();
  initializeReplacementCarousels();
  document.addEventListener('astro:page-load', initializeHeroVideos);
  document.addEventListener('astro:page-load', initializeReplacementCarousels);
</script>
