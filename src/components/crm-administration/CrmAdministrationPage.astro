---
import FinalContactSection from '../final-contact/FinalContactSection.astro';
import ServicePageAnimations from '../service-animation/ServicePageAnimations.astro';
import type { ContactCopy } from '../../data/contact';
import type { CrmAdministrationContent } from '../../data/crmAdministration';

type Props = {
  content: CrmAdministrationContent;
  contactCopy: ContactCopy;
};

const { content, contactCopy } = Astro.props;
---

<main class="crm-page">
  <section class="crm-hero" aria-labelledby="crm-hero-title">
    <video class="crm-hero-video" aria-hidden="true" autoplay muted loop playsinline preload="metadata">
      <source src="/assets/binary-wave-bg.webm" type="video/webm" />
      <source src="/assets/binary-wave-bg.mp4" type="video/mp4" />
    </video>

    <div class="crm-hero-copy">
      <p class="crm-eyebrow">{content.hero.eyebrow}</p>
      <h1 id="crm-hero-title">{content.hero.title}</h1>
      <p>{content.hero.copy}</p>
      <div class="crm-hero-actions">
        <button type="button" data-contact-trigger>{content.hero.primaryCta}</button>
        <a href="#plataforma">{content.hero.secondaryCta}</a>
      </div>
    </div>

    <div class="crm-command" aria-hidden="true">
      <div class="crm-command-bar">
        <span class="crm-command-status"><i></i> CRM / 360</span>
        <span>AGSIT OS</span>
      </div>
      <div class="crm-command-body">
        <div class="crm-command-orbit">
          <span class="crm-command-core">
            <small>CRM</small>
            <strong>{content.hero.coreLabel}</strong>
          </span>
          {
            content.hero.signals.map((signal, index) => (
              <span class={`crm-command-signal crm-command-signal-${index + 1}`}>
                <i></i>
                {signal}
              </span>
            ))
          }
        </div>
        <div class="crm-command-feed">
          {content.hero.signals.slice(0, 3).map((signal, index) => (
            <span>
              <i>{String(index + 1).padStart(2, '0')}</i>
              {signal}
              <b></b>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="crm-contrast" aria-labelledby="crm-contrast-title">
    <div class="crm-section-heading">
      <p class="crm-eyebrow">{content.contrast.eyebrow}</p>
      <h2 id="crm-contrast-title">{content.contrast.title}</h2>
    </div>

    <div class="crm-contrast-board">
      <article class="crm-contrast-column crm-contrast-column-before">
        <span>{content.contrast.beforeLabel}</span>
        <ul>
          {content.contrast.before.map((item, index) => (
            <li>
              <small>{String(index + 1).padStart(2, '0')}</small>
              {item}
            </li>
          ))}
        </ul>
      </article>

      <div class="crm-contrast-switch" aria-hidden="true">
        <span></span>
        <i></i>
        <span></span>
      </div>

      <article class="crm-contrast-column crm-contrast-column-after">
        <span>{content.contrast.afterLabel}</span>
        <ul>
          {content.contrast.after.map((item, index) => (
            <li>
              <small>{String(index + 1).padStart(2, '0')}</small>
              {item}
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section id="plataforma" class="crm-modules" aria-labelledby="crm-modules-title">
    <div class="crm-section-heading">
      <p class="crm-eyebrow">{content.modules.eyebrow}</p>
      <h2 id="crm-modules-title">{content.modules.title}</h2>
      <p>{content.modules.copy}</p>
    </div>

    <div class="crm-module-map">
      <div class="crm-module-axis" aria-hidden="true">
        <span>CRM</span>
        <i></i>
        <strong>360</strong>
      </div>
      <div class="crm-module-grid">
        {
          content.modules.items.map((item, index) => (
            <article>
              <div class="crm-module-meta">
                <span>{item.code}</span>
                <small>{String(index + 1).padStart(2, '0')}</small>
              </div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="crm-workflows" aria-labelledby="crm-workflows-title">
    <div class="crm-workflows-copy">
      <p class="crm-eyebrow">{content.workflows.eyebrow}</p>
      <h2 id="crm-workflows-title">{content.workflows.title}</h2>
      <p>{content.workflows.copy}</p>
    </div>
    <div class="crm-workflow-steps">
      {
        content.workflows.items.map((item) => (
          <article>
            <span>{item.label}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
            <i aria-hidden="true"></i>
          </article>
        ))
      }
    </div>
  </section>

  <section class="crm-ai" aria-labelledby="crm-ai-title">
    <div class="crm-ai-copy">
      <p class="crm-eyebrow">{content.ai.eyebrow}</p>
      <h2 id="crm-ai-title">{content.ai.title}</h2>
      <p>{content.ai.copy}</p>
      <div class="crm-ai-pulse" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <i>AI</i>
      </div>
    </div>
    <div class="crm-ai-grid">
      {
        content.ai.capabilities.map((capability, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{capability.title}</h3>
            <ul>
              {capability.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="crm-outcomes" aria-labelledby="crm-outcomes-title">
    <div class="crm-outcomes-heading">
      <p class="crm-eyebrow">{content.outcomes.eyebrow}</p>
      <h2 id="crm-outcomes-title">{content.outcomes.title}</h2>
    </div>
    <ol>
      {content.outcomes.items.map((item, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p>{item}</p>
        </li>
      ))}
    </ol>
  </section>

  <FinalContactSection copy={contactCopy} />

  <ServicePageAnimations />
</main>
