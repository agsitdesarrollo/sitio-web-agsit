---
import FinalContactSection from '../final-contact/FinalContactSection.astro';
import ServiceSlidesController from '../service-slides/ServiceSlidesController.astro';
import type { ContactCopy } from '../../data/contact';
import type { CrmAdministrationContent } from '../../data/crmAdministration';

type Props = {
  content: CrmAdministrationContent;
  contactCopy: ContactCopy;
};

const { content, contactCopy } = Astro.props;
---

<main class="crm-platform-page" data-service-touch-threshold="22">
  <section class="crm-platform-hero" aria-labelledby="crm-platform-title">
    <div class="crm-shell crm-first-panels-shell crm-platform-hero-layout">
      <div class="crm-platform-hero-copy">
        <p class="crm-kicker">{content.hero.eyebrow}</p>
        <h1 id="crm-platform-title">
          {content.hero.title}
          <em>{content.hero.titleAccent}</em>
        </h1>
        <p class="crm-platform-lead">{content.hero.copy}</p>
        <div class="crm-platform-actions">
          <button type="button" data-contact-trigger>{content.hero.primaryCta}</button>
        </div>
      </div>

      <figure class="crm-hero-visual">
        <img src="/assets/hero-crm-example.png" alt={content.hero.visualAlt} loading="eager" decoding="async" />
      </figure>
    </div>
  </section>

  <section id="plataforma" class="crm-connection-story" aria-labelledby="crm-connection-title">
    <div class="crm-shell crm-first-panels-shell crm-connection-layout">
      <div class="crm-section-intro crm-connection-copy">
        <p class="crm-kicker">{content.convergence.eyebrow}</p>
        <h2 id="crm-connection-title">{content.convergence.title}</h2>
        <p>{content.convergence.copy}</p>
        <div class="crm-connection-actions">
          <button type="button" data-contact-trigger>{content.hero.primaryCta}</button>
        </div>
      </div>
      <figure class="crm-connection-visual" aria-hidden="true">
        <img src="/assets/apps-example.png" alt="" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="crm-pillars crm-pillar-step crm-pillar-step-1" aria-labelledby="crm-pillars-title">
    <svg class="crm-pillar-path crm-pillar-path-to-left" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs><clipPath id="crm-pillar-mask-1"><rect class="crm-pillar-path-fill" data-pillar-fill-stop="33" x="0" y="0" width="100" height="0" /></clipPath></defs>
      <path class="crm-pillar-path-base" d="M52 0V50C52 68 47 78 47 100" />
      <path class="crm-pillar-path-progress" d="M52 0V50C52 68 47 78 47 100" clip-path="url(#crm-pillar-mask-1)" />
    </svg>
    <span class="crm-pillar-path-marker crm-pillar-path-marker-center" aria-hidden="true"></span>
    <div class="crm-shell crm-pillar-step-shell">
      <div class="crm-section-intro crm-section-intro-centered">
        <p class="crm-kicker">{content.pillars.eyebrow}</p>
        <h2 id="crm-pillars-title">{content.pillars.title}</h2>
        <p>{content.pillars.copy}</p>
      </div>
      {content.pillars.items.slice(0, 1).map((item) => (
        <article class="crm-pillar-card crm-pillar-card-1">
          <figure class="crm-pillar-media"><img src="/assets/example1.png" alt="" loading="lazy" decoding="async" /></figure>
          <div class="crm-pillar-card-copy">
            <span class="crm-pillar-index">{item.eyebrow}</span>
            <h3 id="crm-pillar-item-1">{item.title}</h3>
            <p>{item.copy}</p>
            <small>{item.detail}</small>
          </div>
        </article>
      ))}
    </div>
  </section>

  {content.pillars.items.slice(1).map((item, index) => {
    const itemNumber = index + 2;
    const pathDirection = index % 2 === 0 ? 'crm-pillar-path-to-right' : 'crm-pillar-path-to-left';
    const markerDirection = index % 2 === 0 ? 'crm-pillar-path-marker-left' : 'crm-pillar-path-marker-center';
    const imageSource = itemNumber % 2 === 1 ? '/assets/example1.png' : '/assets/example2.png';
    const pathData = itemNumber === 6
      ? 'M47 0V50'
      : index % 2 === 0 ? 'M47 0V50C47 68 52 78 52 100' : 'M52 0V50C52 68 47 78 47 100';
    const maskId = `crm-pillar-mask-${itemNumber}`;

    return (
      <section class:list={['crm-pillar-step', `crm-pillar-step-${itemNumber}`]} aria-labelledby={`crm-pillar-item-${itemNumber}`}>
        <svg class:list={['crm-pillar-path', pathDirection]} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <defs><clipPath id={maskId}><rect class="crm-pillar-path-fill" data-pillar-fill-stop="50" x="0" y="0" width="100" height="0" /></clipPath></defs>
          <path class="crm-pillar-path-base" d={pathData} />
          <path class="crm-pillar-path-progress" d={pathData} clip-path={`url(#${maskId})`} />
        </svg>
        <span class:list={['crm-pillar-path-marker', markerDirection]} aria-hidden="true"></span>
        <div class="crm-shell crm-pillar-step-shell">
          <article class:list={['crm-pillar-card', `crm-pillar-card-${itemNumber}`]}>
            <figure class="crm-pillar-media"><img src={imageSource} alt="" loading="lazy" decoding="async" /></figure>
            <div class="crm-pillar-card-copy">
              <span class="crm-pillar-index">{item.eyebrow}</span>
              <h3 id={`crm-pillar-item-${itemNumber}`}>{item.title}</h3>
              <p>{item.copy}</p>
              <small>{item.detail}</small>
            </div>
          </article>
        </div>
      </section>
    );
  })}

  <section class="crm-journey" aria-labelledby="crm-journey-title">
    <div class="crm-shell">
      <div class="crm-section-intro">
        <p class="crm-kicker">{content.journey.eyebrow}</p>
        <h2 id="crm-journey-title">{content.journey.title}</h2>
        <p>{content.journey.copy}</p>
      </div>
      <ol class="crm-journey-list">
        {content.journey.steps.map((step) => (
          <li>
            <span>{step.label}</span>
            <div><h3>{step.title}</h3><p>{step.copy}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="crm-collaboration" aria-labelledby="crm-collaboration-title">
    <div class="crm-shell crm-collaboration-layout">
      <div class="crm-collaboration-copy">
        <p class="crm-kicker">{content.collaboration.eyebrow}</p>
        <h2 id="crm-collaboration-title">{content.collaboration.title}</h2>
        <p>{content.collaboration.copy}</p>
        <ul>
          {content.collaboration.outcomes.map((outcome) => <li>{outcome}</li>)}
        </ul>
      </div>
      <div class="crm-work-surface" aria-hidden="true">
        <div class="crm-work-surface-head"><i></i><span></span><b></b></div>
        <div class="crm-work-message crm-work-message-primary"><b></b><span></span><span></span></div>
        <div class="crm-work-message crm-work-message-secondary"><b></b><span></span></div>
        <div class="crm-work-task"><i></i><div><b></b><span></span></div><em></em></div>
        <div class="crm-work-call"><i></i><span></span><span></span><span></span></div>
      </div>
    </div>
  </section>

  <section class="crm-integrations" aria-labelledby="crm-integrations-title">
    <div class="crm-shell crm-integrations-layout">
      <div class="crm-section-intro">
        <p class="crm-kicker">{content.integrations.eyebrow}</p>
        <h2 id="crm-integrations-title">{content.integrations.title}</h2>
        <p>{content.integrations.copy}</p>
      </div>
      <ul class="crm-integration-list">
        {content.integrations.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="crm-implementation" aria-labelledby="crm-implementation-title">
    <div class="crm-shell">
      <div class="crm-section-intro crm-section-intro-centered">
        <p class="crm-kicker">{content.implementation.eyebrow}</p>
        <h2 id="crm-implementation-title">{content.implementation.title}</h2>
        <p>{content.implementation.copy}</p>
      </div>
      <ol class="crm-implementation-list">
        {content.implementation.steps.map((step) => (
          <li>
            <span>{step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FinalContactSection copy={contactCopy} />
  <ServiceSlidesController />
</main>
