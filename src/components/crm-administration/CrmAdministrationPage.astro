---
import type { ContactCopy } from '../../data/contact';
import type { CrmAdministrationContent } from '../../data/crmAdministration';
import TechnologySolutionDetailPage from '../technology-solution-detail/TechnologySolutionDetailPage.astro';
import PlatformReplacementSection from './PlatformReplacementSection.astro';

type Props = {
  content: CrmAdministrationContent;
  contactCopy: ContactCopy;
};

const { content, contactCopy } = Astro.props;
---

<TechnologySolutionDetailPage
  hero={content.hero}
  heroMedia={{
    poster: '/assets/hero-crm-example.png',
    sources: [{ src: '/assets/binary-wave-bg.mp4', type: 'video/mp4' }],
  }}
  journey={content.pillars}
  contactCopy={contactCopy}
>
  <PlatformReplacementSection slot="secondary-section" content={content.convergence} />
</TechnologySolutionDetailPage>
