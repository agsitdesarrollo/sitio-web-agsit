---
import type { MarketingServiceContent } from '../../types/marketingService.types';
import MarketingServiceEcho from './MarketingServiceEcho.astro';
type Props = { copy: MarketingServiceContent['hero']; alt: MarketingServiceContent['hero'] };
const { copy, alt } = Astro.props;
// Soft stars scattered around the window, in percentages so they never depend on the aspect ratio.
const stars = [[7,16,1],[91,12,.8],[13,66,.9],[93,62,1.1],[52,8,.7],[78,76,.8],[3,42,.7],[38,80,.9],[96,38,.7],[24,10,.6]];
---
<section class="ms-panel ms-hero" data-ms-panel="hero" aria-labelledby="ms-title">
  <div class="ms-stars" aria-hidden="true">{stars.map(([x,y,k],i)=><svg data-ms-star viewBox="-16 -16 32 32" style={`left:${x}%;top:${y}%;--s:${k};opacity:${0.35+i%3*0.18}`}><path d="M0,-16 Q0,0 16,0 Q0,0 0,16 Q0,0 -16,0 Q0,0 0,-16" fill="currentColor"/></svg>)}</div>
  <div class="ms-hero__frame" data-ms-fit>
    <svg class="ms-browser" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.5"><rect data-ms-draw pathLength="1" x="0" y="0" width="100%" height="100%" rx="14"/><line data-ms-draw pathLength="1" x1="0" y1="46" x2="100%" y2="46"/><circle data-ms-draw pathLength="1" cx="26" cy="23" r="5.5"/><circle data-ms-draw pathLength="1" cx="46" cy="23" r="5.5"/><circle data-ms-draw pathLength="1" cx="66" cy="23" r="5.5"/></g></svg>
    <span class="ms-browser-echo" aria-hidden="true"></span>
    <div class="ms-hero__stage">
      <p class="ms-eyebrow" data-ms-intro data-ms-alt={alt.eyebrow}>{copy.eyebrow}</p>
      <div class="ms-hero__title">
        <h1 id="ms-title" data-ms-intro>{copy.lines.map((line,i)=><span class:list={['ms-hero__line', {'ms-hero__line--fill':i===0}]} data-ms-alt={alt.lines[i]}><span class="ms-hero__text">{line}</span>{i===0 && <span class="ms-fill-mask" aria-hidden="true"><span class="ms-fill-text">{line}</span></span>}</span>)}</h1>
        <div class="ms-seal"><MarketingServiceEcho text={copy.seal} alt={alt.seal}/></div>
      </div>
      <div class="ms-hero__details"><p data-ms-alt={alt.copy}>{copy.copy}</p><button class="ms-button" type="button" data-contact-trigger><span data-ms-alt={alt.cta}>{copy.cta}</span><span aria-hidden="true">↗</span></button></div>
    </div>
    <button class="ms-explore" type="button" data-ms-next><span data-ms-alt={alt.explore}>{copy.explore}</span><span aria-hidden="true">↓</span></button>
  </div>
</section>
