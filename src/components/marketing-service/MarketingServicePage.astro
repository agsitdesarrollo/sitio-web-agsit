---
import FinalContactSection from '../final-contact/FinalContactSection.astro';
import type { ContactCopy } from '../../data/contact';
import type { MarketingServiceContent } from '../../types/marketingService.types';
import MarketingServiceHero from './MarketingServiceHero.astro';
import MarketingServiceProblems from './MarketingServiceProblems.astro';
import MarketingServiceSolution from './MarketingServiceSolution.astro';
import MarketingServiceAudience from './MarketingServiceAudience.astro';
import MarketingServiceServices from './MarketingServiceServices.astro';
import './MarketingServicePage.css';
type Props = { content: MarketingServiceContent; contactCopy: ContactCopy };
const { content, contactCopy } = Astro.props;
// The other language, so the fit measurement always uses the longer text of the two.
const alt = content.counterpart ?? content;
---
<main class="ms-page" data-marketing-service>
  <div class="ms-experience"><div class="ms-viewport">
    <span class="ms-ground" aria-hidden="true"></span>
    <MarketingServiceHero copy={content.hero} alt={alt.hero}/>
    <MarketingServiceProblems copy={content.problems} alt={alt.problems}/>
    <MarketingServiceSolution copy={content.solution} alt={alt.solution} lang={content.lang}/>
    <MarketingServiceAudience copy={content.audience} alt={alt.audience} lang={content.lang}/>
    <MarketingServiceServices copy={content.services} alt={alt.services} lang={content.lang}/>
    <nav class="ms-navigation" aria-label={content.navigation.label}><button type="button" data-ms-previous aria-label={content.navigation.previous}>↑</button><span class="ms-position" aria-live="polite" aria-atomic="true"></span><button type="button" data-ms-next aria-label={content.navigation.next}>↓</button><a href="#contacto">{content.navigation.contact}<span aria-hidden="true"> ↗</span></a></nav>
  </div></div>
  <FinalContactSection copy={contactCopy}/>
</main>
<script>
  import { setupMarketingServiceScroll } from './marketingServiceScroll';
  setupMarketingServiceScroll();
</script>
