---
import type { MarketingServiceContent } from '../../types/marketingService.types';
type Props = { copy: MarketingServiceContent['problems']; alt: MarketingServiceContent['problems'] };
const { copy, alt } = Astro.props;
const plain = (phrase?: { before: string; accent: string; after?: string }) => phrase ? `${phrase.before}${phrase.accent}${phrase.after ?? ''}` : undefined;
---
<section class="ms-panel ms-problems" data-ms-panel="problems" aria-labelledby="ms-problems-title">
  <div class="ms-section-content" data-ms-fit>
    <div class="ms-heading-row"><h2 id="ms-problems-title" data-ms-alt={alt.title}>{copy.title}</h2><button class="ms-motion-toggle" type="button" aria-pressed="false" data-ms-pause data-pause={copy.pause} data-resume={copy.resume}>{copy.pause}</button></div>
    <div class="ms-problem-rows">{copy.rows.map((row,r)=><div class="ms-problem-row">{row.map((phrase,c)=><article class="ms-bordered ms-problem-card"><p data-ms-alt={plain(alt.rows[r]?.[c])} data-ms-flat>{phrase.before}<strong>{phrase.accent}</strong>{phrase.after}</p></article>)}</div>)}</div>
  </div>
</section>
