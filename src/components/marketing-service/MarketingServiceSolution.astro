---
import type { MarketingServiceContent } from '../../types/marketingService.types';
import MarketingServiceEcho from './MarketingServiceEcho.astro';
import MarketingServiceMedia from './MarketingServiceMedia.astro';
type Props = { copy: MarketingServiceContent['solution']; lang: MarketingServiceContent['lang'] };
const { copy, lang } = Astro.props;
---
<section class="ms-panel ms-solution" data-ms-panel="solution" aria-labelledby="ms-solution-title">
  <div class="ms-solution__text" data-ms-fit><p class="ms-eyebrow">{copy.eyebrow}</p><h2 id="ms-solution-title"><MarketingServiceEcho text={copy.title}/></h2><p class="ms-solution__copy">{copy.copy}</p></div>
  <div class="ms-clouds" aria-hidden="true">{copy.clouds.map((media,i)=><div class="ms-cloud" style={`--cloud-side:${i%2===0?-1:1}`}><MarketingServiceMedia media={media} lang={lang} cloud/></div>)}</div>
</section>
