---
import type { SupportedLang } from '../../i18n/ui';

type Props = {
  lines: string[];
  lang: SupportedLang;
};

const { lines, lang } = Astro.props;
const label = lang === 'es' ? 'Presentación corporativa AGSIT' : 'AGSIT corporate presentation';
---

<div class="video-story-overlap">
  <!-- Este lienzo fijo es el único propietario visual desde el final del zoom
       del logotipo hasta Contacto. El documento se mueve oculto debajo. -->
  <div class="video-handoff-scene js-video-handoff-scene" data-canvas-state="idle" aria-hidden="true">
    <!-- El mismo lienzo posee el logo y el video. La lámina de Alianzas solo
         entrega su rectángulo de reposo; nunca pinta el tramo inmersivo. -->
    <div class="video-handoff-logo js-video-handoff-logo" aria-hidden="true">
      <img class="video-handoff-logo-mark js-video-handoff-logo-mark" src="/assets/logo-agsit.svg" alt="" />
    </div>

    <div class="video-handoff-shell js-video-handoff-shell">
      <div class="video-handoff-host js-video-handoff-host"></div>
    </div>

    <div class="video-handoff-copy js-video-handoff-copy" aria-live="polite">
      {
        lines.map((line, index) => (
          <p class="video-handoff-line js-video-handoff-line" data-handoff-line={index}>{line}</p>
        ))
      }
    </div>
  </div>

  <!-- La sección conserva una parada real en el documento y sirve como hogar
       del video fuera de la experiencia. Nunca compite por los gestos. -->
  <section class="video-story-section js-video-story" aria-label={label}>
    <div class="video-story-viewport" aria-hidden="true">
      <div class="video-story-stage">
        <div class="video-story-frame js-video-story-frame">
          <video
            class="video-story-media"
            data-src="/assets/AGSIT%20Presentaci%C3%B3n%20Corporativa%20-%20AGSIT%20Consultor%C3%ADa%20Especializada%20en%20Soluciones%20Empresariales.mp4"
            muted
            loop
            playsinline
            preload="none"
            aria-label={label}
          ></video>
        </div>
      </div>
    </div>
  </section>
</div>
