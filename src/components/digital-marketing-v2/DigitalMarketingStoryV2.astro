---
import FinalContactSection from '../final-contact/FinalContactSection.astro';
import DigitalMarketingOrbitHero from './DigitalMarketingOrbitHero.astro';
import type { ContactCopy } from '../../data/contact';
import type { DigitalMarketingV2Content, StoryInlineVisual } from '../../data/digitalMarketingV2';

type Props = {
  content: DigitalMarketingV2Content;
  contactCopy: ContactCopy;
};

const { content, contactCopy } = Astro.props;
const orbitText = content.metadata.htmlLang.startsWith('en')
  ? 'Digital Marketing'
  : 'Marketing Digital';

const assetByVisual: Record<StoryInlineVisual, string> = {
  eye: '/assets/storytelling-v2/brand-eye.svg',
  flower: '/assets/storytelling-v2/brand-target.svg',
  heart: '/assets/storytelling-v2/brand-pulse.svg',
  magnifier: '/assets/lupa-mejorada-transparente.png',
};
---

<main class="dm-v2-page js-dm-v2-page">
  <DigitalMarketingOrbitHero text={orbitText} />

  <section class="dm-v2-hero js-dm-v2-hero" aria-labelledby="dm-v2-title">
    <img class="dm-v2-hero-circle js-dm-v2-hero-circle" src="/assets/storytelling-v2/brand-halo.svg" alt="" />
    <div class="dm-v2-hero-title">
      <p class="dm-v2-eyebrow js-dm-v2-eyebrow">{content.hero.eyebrow}</p>
      <h1 id="dm-v2-title">
        <span class="dm-v2-title-primary js-dm-v2-title-primary">{content.hero.primary}</span>
        <span class="dm-v2-title-secondary js-dm-v2-title-secondary">{content.hero.secondary}</span>
      </h1>
      <p class="dm-v2-hero-copy js-dm-v2-hero-copy">{content.hero.copy}</p>
      <button type="button" class="dm-v2-hero-cta js-dm-v2-hero-cta" data-contact-trigger>{content.hero.cta}</button>
    </div>
  </section>

  <section id="enfoque-digital" class="dm-v2-focus js-dm-v2-focus" aria-labelledby="dm-v2-focus-title">
    <img
      class="dm-v2-focus-orbit js-dm-v2-focus-orbit"
      src="/assets/storytelling-v2/brand-halo.svg"
      alt=""
      aria-hidden="true"
    />
    <div class="dm-v2-focus-shell">
      <p class="dm-v2-eyebrow">{content.focus.eyebrow}</p>
      <div class="dm-v2-focus-stage js-dm-v2-focus-stage">
        <div class="dm-v2-focus-copy dm-v2-focus-copy-visible">
          <h2 id="dm-v2-focus-title">{content.focus.title}</h2>
          <p aria-hidden="true">{content.focus.copy}</p>
        </div>
        <div class="dm-v2-focus-copy dm-v2-focus-copy-hidden" aria-hidden="true">
          <h2>{content.focus.title}</h2>
          <p>{content.focus.copy}</p>
        </div>
        <div class="dm-v2-focus-lens js-dm-v2-focus-lens" aria-hidden="true">
          <img class="dm-v2-focus-lens-art" src="/assets/lupa-mejorada-transparente.png" alt="" />
        </div>
      </div>
      <p class="dm-v2-focus-hint" aria-hidden="true">
        <span class="dm-v2-focus-hint-desktop">{content.focus.hintDesktop}</span>
        <span class="dm-v2-focus-hint-touch">{content.focus.hintTouch}</span>
      </p>
    </div>
  </section>

  <section id="narrativa-digital-uno" class="dm-v2-narrative-track js-dm-v2-track-one">
    <article class="dm-v2-pin-section dm-v2-pin-one" aria-label={content.narrative[0].ariaLabel}>
      <p class="dm-v2-large-copy js-dm-v2-words js-dm-v2-words-one" aria-label={content.narrative[0].ariaLabel}>
        {
          content.narrative[0].segments.map((segment) => (
            <>
              {segment.text}
              {segment.accent && <span class="dm-v2-serif">{segment.accent}</span>}
              {
                segment.visual && (
                  <span class:list={['dm-v2-inline-visual', `dm-v2-inline-${segment.visual}`]} aria-hidden="true">
                    <img
                      class:list={[
                        segment.visual === 'magnifier' && 'js-dm-v2-inline-lens',
                        segment.visual === 'flower' && 'js-dm-v2-inline-target',
                      ]}
                      src={assetByVisual[segment.visual]}
                      alt=""
                    />
                  </span>
                )
              }
            </>
          ))
        }
      </p>
    </article>
  </section>

  <section id="narrativa-digital-dos" class="dm-v2-narrative-track js-dm-v2-track-two">
    <article class="dm-v2-pin-section dm-v2-pin-two" aria-label={content.narrative[1].ariaLabel}>
      <div class="dm-v2-second-copy">
        <p class="dm-v2-large-copy js-dm-v2-words js-dm-v2-words-two" aria-label={content.narrative[1].ariaLabel}>
          {
            content.narrative[1].segments.map((segment) => (
              <>
                {segment.text}
                {segment.accent && <span class="dm-v2-serif">{segment.accent}</span>}
                {
                  segment.visual && (
                    <span class:list={['dm-v2-inline-visual', `dm-v2-inline-${segment.visual}`]} aria-hidden="true">
                      <img class={segment.visual === 'heart' ? 'js-dm-v2-heart' : ''} src={assetByVisual[segment.visual]} alt="" />
                    </span>
                  )
                }
              </>
            ))
          }
        </p>
      </div>
      <div class="dm-v2-second-visual" aria-hidden="true">
        <div class="dm-v2-target-wrap js-dm-v2-target">
          <img class="dm-v2-second-target js-dm-v2-second-target" src="/assets/storytelling-v2/brand-target.svg" alt="" />
          <img class="dm-v2-target-arrow js-dm-v2-target-arrow" src="/assets/storytelling-v2/target-arrow.svg" alt="" />
          <span class="dm-v2-target-pulse"></span>
        </div>
      </div>
    </article>
  </section>

  <section class="dm-v2-transition-track js-dm-v2-transition-track">
    <article class="dm-v2-transition js-dm-v2-transition" aria-labelledby="dm-v2-services-title">
      <h2 id="dm-v2-services-title">
        <span class="js-dm-v2-transition-left">{content.transitionTitle.first}</span>
        <span class="js-dm-v2-transition-right">{content.transitionTitle.second}</span>
      </h2>
    </article>
  </section>

  <section
    id="servicios-marketing-digital"
    class="dm-v2-card-section js-dm-v2-card-section"
    aria-label={content.cards.ariaLabel}
  >
    <ul class="dm-v2-card-stack">
      {
        content.cards.items.map((card, index) => (
          <li
            class:list={['dm-v2-card', `dm-v2-card-${card.theme}`, 'js-dm-v2-card']}
            style={`--card-index: ${index}; --card-top: ${40 + index * 20}px; --card-mb: ${100 - index * 20}px`}
          >
            <div class="dm-v2-card-copy">
              <p class="dm-v2-card-eyebrow">{card.eyebrow}</p>
              <h3>{card.title}</h3>
              <p>{card.copy}</p>
              {
                card.href && card.cta && (
                  <a class="dm-v2-card-link" href={card.href}>
                    <span>{card.cta}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                )
              }
            </div>
            <div class="dm-v2-card-visual" aria-hidden="true">
              <video
                class="dm-v2-card-video"
                src={card.srcvideo}
                muted
                playsinline
                preload="metadata"
                loop
                autoplay
              ></video>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <FinalContactSection copy={contactCopy} />
</main>

<script>
  import { setupDigitalMarketingStory } from './digitalMarketingStoryController';

  const startDigitalMarketingStory = () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(setupDigitalMarketingStory);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startDigitalMarketingStory, { once: true });
  } else {
    startDigitalMarketingStory();
  }
</script>
