---
type Props = { word: string };
const { word } = Astro.props;
---
<div class="ms-split" data-story-split>
  <p class="ms-split-static">{word}</p>
  <div class="ms-split-whole" aria-hidden="true"><span>{word}</span></div>
  <div class="ms-split-half ms-split-left" aria-hidden="true"><div class="ms-split-panel" data-split-left><span>{word}</span></div></div>
  <div class="ms-split-half ms-split-right" aria-hidden="true"><div class="ms-split-panel" data-split-right><span>{word}</span></div></div>
</div>
