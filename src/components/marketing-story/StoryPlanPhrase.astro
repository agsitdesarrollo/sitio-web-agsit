---
import type { MarketingStoryContent } from '../../types/marketingStory.types';
import './marketing-story.plan.css';
import StoryPointServices from './StoryPointServices.astro';
type Props = { content: MarketingStoryContent['plan']; services: MarketingStoryContent['services'] };
const { content, services } = Astro.props;
const letters = Array.from(content.phrase);
---
<section class="ms-plan" id="ms-plan" aria-labelledby="ms-plan-title" data-plan>
  <div class="ms-plan-title">
    <h2 id="ms-plan-title" class="ms-plan-semantic">{content.phrase}</h2>
    {[0, 1].map(half => <div class:list={['ms-plan-copy', half === 0 ? 'ms-plan-upper' : 'ms-plan-lower']} data-plan-half={half} aria-hidden="true">
      {letters.map((letter, index) => <span class="ms-plan-letter-mask"><span data-plan-letter={index}>{letter === ' ' ? '\u00a0' : letter}</span></span>)}
    </div>)}
  </div>
  <p class="ms-plan-cue" data-plan-cue>{content.cue}</p>
  <canvas class="ms-plan-particles" data-story-particles data-plan-particles aria-hidden="true"></canvas>
  <div class="ms-plan-service-frame" data-plan-frame aria-hidden="true"></div>
  <StoryPointServices content={services} />
</section>
