---
import type { MarketingStoryContent } from '../../types/marketingStory.types';
import './marketing-story.closing.css';
type Props = { content: MarketingStoryContent['closing'] };
const { content } = Astro.props;
---
<div class="ms-closing" data-closing>
  <div class="ms-closing-mark" data-closing-mark aria-hidden="true">
    <div class="ms-closing-logo" data-closing-logo>
      <img src="/assets/logo-agsit.svg" alt="" width="509" height="441" decoding="async" />
      <span class="ms-closing-glint"></span>
    </div>
  </div>
  <p class="ms-closing-phrase">{content.phrase}</p>
  <button class="ms-button" data-contact-trigger>{content.cta}</button>
</div>
