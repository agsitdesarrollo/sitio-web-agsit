---
import type { MarketingStoryContent } from '../../types/marketingStory.types';
import { serviceShapes } from './marketing-story.shapes';
import './marketing-story.services.css';
type Props = { content: MarketingStoryContent['services'] };
const { content } = Astro.props;
const icons = ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10M12 11v2', 'M3 4h18l-7 9v6l-4 2v-8Z', 'M12 4C8 1 5 4 5 7c-4 1-3 7 0 8-1 5 5 8 7 4m0-15c4-3 7 0 7 3 4 1 3 7 0 8 1 5-5 8-7 4V4M8 8l2 3-2 3m8-6-2 3 2 3', 'M9 3h6l1 3 3 1 2 5-2 5-3 1-1 3H9l-1-3-3-1-2-5 2-5 3-1ZM8 12a4 4 0 1 0 8 0 4 4 0 0 0-8 0', 'M5 4h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 3v-3a2 2 0 0 1-2-2V6a2 2 0 0 1 3-2M7 11h.01M12 11h.01M17 11h.01'];
---
<section class="ms-services" data-services aria-label={content.label} data-announcement={content.announcement}>
  <div class="ms-service-figure" data-service-figure aria-hidden="true"></div>
  <div class="ms-services-bottom" data-services-bottom>
    <div class="ms-service-stack">
      {content.items.map((item, index) => <article class="ms-service-card" data-service-card data-service-name={item.name} aria-labelledby={`ms-service-${index}`}>
        <svg class="ms-service-static-figure" viewBox="0 0 400 400" aria-hidden="true">{Array.from({ length: 450 }, (_, i) => { const point = serviceShapes[index](i, 450); return <circle cx={point.x * 400} cy={point.y * 400} r="1.7" />; })}</svg>
        <div class="ms-service-heading"><svg class="ms-service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[index]} /></svg><h2 id={`ms-service-${index}`}>{item.name}</h2></div>
        <div class="ms-service-copy"><p class="ms-service-line">{item.title}</p><p class="ms-service-description">{item.copy}</p></div>
      </article>)}
    </div>
    <nav class="ms-service-controls" aria-label={content.label}>
      <span class="ms-service-counter" data-service-counter aria-hidden="true">1 / 5</span>
      <div class="ms-service-arrows">
        <button type="button" data-service-prev aria-label={content.previous}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg></button>
        <button type="button" data-service-next aria-label={content.next}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
      </div>
    </nav>
  </div>
  <p class="ms-sr" data-service-announcement role="status" aria-live="polite" aria-atomic="true"></p>
</section>
