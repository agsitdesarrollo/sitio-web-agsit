---
import type { MarketingStoryContent } from '../../types/marketingStory.types';
import './marketing-story.scenes.css';
type Props = { copy: MarketingStoryContent['manifesto']['scenes'] };
const { copy } = Astro.props;
// Smooth growth curve with small dips; the same path draws the line and closes the area.
const points = [[8, 100], [48, 84], [84, 90], [122, 62], [158, 69], [200, 40], [238, 47], [292, 14]].map(([x, y]) => [x, Math.round(y * .75 * 10) / 10]);
const curve = points.map((p, i) => {
  if (!i) return `M${p[0]} ${p[1]}`;
  const [p0, p1, p2, p3] = [points[i - 2] || points[i - 1], points[i - 1], p, points[i + 1] || p];
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6], c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  return `C${c1.map(Math.round)} ${c2.map(Math.round)} ${p2}`;
}).join('');
const area = `${curve}L292 90L8 90Z`;
const end = points[points.length - 1];
const people = Array.from({ length: 9 });
---
<div class="ms-scenes" data-scenes aria-hidden="true">
  <div class="ms-scene" data-scene="0">
    <div class="ms-sc-attract" data-a-box>
      <div class="ms-sc-people">
        {people.map(() => <span class="ms-sc-person" data-a-person><svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><circle cx="14" cy="14" r="13.2" class="ms-sc-person-bg" /><circle cx="14" cy="11" r="3.6" /><path d="M7.6 21c.8-3.6 3.3-5.4 6.4-5.4s5.6 1.8 6.4 5.4" /></svg></span>)}
      </div>
      <div class="ms-sc-card" data-a-card>
        <div class="ms-sc-row">
          <span class="ms-sc-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5 5.6 5h12.8L20 9.5M4 9.5c0 1.4 1.2 2.5 2.7 2.5s2.65-1.1 2.65-2.5c0 1.4 1.2 2.5 2.65 2.5s2.65-1.1 2.65-2.5c0 1.4 1.2 2.5 2.7 2.5S20 10.9 20 9.5M5.5 12.5V19h13v-6.5M10 19v-4h4v4" /></svg></span>
          <b>{copy.attract.business}</b>
        </div>
        <div class="ms-sc-lines"><i></i><i></i></div>
        <div class="ms-sc-image"></div>
        <span class="ms-sc-button">{copy.attract.action}</span>
      </div>
      <div class="ms-sc-reach"><span>{copy.attract.reach}</span><div class="ms-sc-track"><i data-a-reach></i></div></div>
    </div>
  </div>

  <div class="ms-scene" data-scene="1">
    <div class="ms-sc-card ms-sc-follow">
      <div class="ms-sc-head"><b>{copy.follow.title}</b><span class="ms-sc-chip ms-sc-status">{copy.follow.status.map(label => <span data-f-status>{label}</span>)}</span></div>
      <ol class="ms-sc-steps" data-f-steps>
        {copy.follow.steps.map((step, index) => <li class="ms-sc-step">
          {index < 2 && <i class="ms-sc-conn"><i data-f-conn></i></i>}
          <span class="ms-sc-node"><i data-f-fill></i><svg viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path data-f-check d="M4 8.4 6.8 11 12 5.4" pathLength="1" /></svg></span>
          <span class="ms-sc-text"><span>{step}</span><span class="ms-sc-text-on" data-f-on>{step}</span>
            {index === 1 && <span class="ms-sc-typing" data-f-typing><i></i><i></i><i></i></span>}
          </span>
        </li>)}
      </ol>
    </div>
  </div>

  <div class="ms-scene" data-scene="2">
    <div class="ms-sc-card ms-sc-grow">
      <div data-g-body>
        <div class="ms-sc-head"><b>{copy.grow.title}</b><span class="ms-sc-chip"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 9 9 2.5M4 2.5h5v5" /></svg>{copy.grow.chip}</span></div>
        <div class="ms-sc-chart">
          <svg viewBox="0 0 300 90" preserveAspectRatio="xMidYMid meet">
            <defs><linearGradient id="ms-sc-area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1f6f92" stop-opacity=".2" /><stop offset="1" stop-color="#1f6f92" stop-opacity="0" /></linearGradient></defs>
            {[17, 38, 60, 82].map(y => <line x1="0" x2="300" y1={y} y2={y} class="ms-sc-guide" />)}
            <path d={area} fill="url(#ms-sc-area)" data-g-area />
            <path d={curve} class="ms-sc-line" pathLength="1" data-g-line />
          </svg>
          <span class="ms-sc-end" style={`left:${end[0] / 3}%;top:${end[1] / .9}%`}><i data-g-halo></i><i data-g-dot></i></span>
        </div>
        <div class="ms-sc-return"><span>{copy.grow.returning}</span><div class="ms-sc-track thin"><i data-g-bar></i></div></div>
      </div>
    </div>
  </div>
</div>
