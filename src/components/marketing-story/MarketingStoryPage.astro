---
import FinalContactSection from '../final-contact/FinalContactSection.astro';
import ScrollVideoHero from './ScrollVideoHero.astro';
import StoryManifesto from './StoryManifesto.astro';
import HeroSplitTransition from './HeroSplitTransition.astro';
import type { MarketingStoryContent } from '../../types/marketingStory.types';
import type { ContactCopy } from '../../data/contact';
import './marketing-story.css'; // Page-local styles; shared service styles stay untouched.
type Props = { content: MarketingStoryContent; contactCopy: ContactCopy };
const { content, contactCopy } = Astro.props;
---
<main class="ms-page" data-marketing-story>
  <div class="ms-story-content">
    <div class="ms-journey-track" data-journey-track>
      <div class="ms-journey-stage" data-journey-stage>
        <ScrollVideoHero content={content.hero} />
        <HeroSplitTransition word={content.transition.word} />
        <StoryManifesto content={content.manifesto} />
      </div>
    </div>
  </div>
  <FinalContactSection copy={contactCopy} />
</main>
<script>
  import { initMarketingStory } from './marketing-story.controller';
  initMarketingStory();
</script>
