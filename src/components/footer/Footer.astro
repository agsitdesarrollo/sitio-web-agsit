---
import { Image } from 'astro:assets';
import type { FooterCopy } from '../../data/footer';
import { getContactInfoForPath } from '../../data/contactInfo';
import type { ServiceItem } from '../../data/services';
import logoImage from '../../assets/images/logo-asit.webp';

type Props = {
  copy: FooterCopy;
  services: ServiceItem[];
  homeHref?: string;
  servicesHref?: string;
  contactHref?: string;
};

const { copy, services, homeHref = '#inicio', servicesHref = '#servicios', contactHref = '#contacto' } = Astro.props;
const contact = getContactInfoForPath(Astro.url.pathname);
---

<footer class="site-footer">
  <div class="footer-brand">
    <Image src={logoImage} alt="Logo AGSIT" loading="lazy" />
    <p>{copy.brand}</p>
  </div>

  <div>
    <h4>{copy.menuTitle}</h4>
    <a href={homeHref}>{copy.nav.home}</a>
    <a href={servicesHref}>{copy.nav.services}</a>
    <a href={contactHref}>{copy.nav.contact}</a>
  </div>

  <div>
    <h4>{copy.servicesTitle}</h4>
    {
      services.map((service) => (
        service.href ? <a href={service.href}>{service.title}</a> : <span>{service.title}</span>
      ))
    }
  </div>

  <div>
    <h4>{copy.contactTitle}</h4>
    <a href={contact.wazeUrl} target="_blank" rel="noopener noreferrer">{contact.address}</a>
    <a href={contact.emailHref}>{contact.email.display}</a>
    <a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">{contact.phone.display}</a>
  </div>
</footer>
