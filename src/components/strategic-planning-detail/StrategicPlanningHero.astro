---
import type { StrategicPlanningDetailContent } from '../../types/strategicPlanningDetail.types';
import './StrategicPlanningHero.css';

type Props = {
  content: StrategicPlanningDetailContent['hero'];
  titleId?: string;
};

const { content, titleId = 'strategic-planning-service-title' } = Astro.props;
const orbitId = `${titleId}-scroll-orbit`;
---

<section class="sp-hero js-sp-hero" aria-labelledby={titleId} data-planning-hero>
  <div class="sp-hero__content">
    <p class="sp-hero__eyebrow js-sp-hero-eyebrow">{content.eyebrow}</p>
    <h1 id={titleId} class="sp-hero__title">
      <span class="sp-hero__title-accent"><span class="js-sp-hero-line">{content.primary}</span></span>
      <span class="sp-hero__title-base"><span class="js-sp-hero-line">{content.secondary}</span></span>
    </h1>
    <p class="sp-hero__copy js-sp-hero-copy">{content.copy}</p>
  </div>

  <button
    class="sp-hero__scroll js-sp-hero-scroll"
    type="button"
    aria-label={content.scrollHint}
  >
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <path id={orbitId} d="M 50,50 m -36,0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0"></path>
      </defs>
      <text>
        <textPath href={`#${orbitId}`} startOffset="0%" textLength="226" lengthAdjust="spacing">{content.scrollLabel}</textPath>
      </text>
    </svg>
    <span aria-hidden="true">↓</span>
  </button>
</section>

<script>
  import gsap from 'gsap';

  const initStrategicPlanningHeroes = () => {
    document.querySelectorAll<HTMLElement>('.js-sp-hero').forEach((root) => {
      if (root.dataset.heroReady === 'true') return;

      root.dataset.heroReady = 'true';

      const eyebrow = root.querySelector<HTMLElement>('.js-sp-hero-eyebrow');
      const lines = Array.from(root.querySelectorAll<HTMLElement>('.js-sp-hero-line'));
      const copy = root.querySelector<HTMLElement>('.js-sp-hero-copy');
      const scrollControl = root.querySelector<HTMLButtonElement>('.js-sp-hero-scroll');
      const animatedItems = [eyebrow, ...lines, copy, scrollControl].filter(
        (item): item is HTMLElement => item instanceof HTMLElement,
      );
      const media = gsap.matchMedia();

      media.add(
        {
          all: 'all',
          reduceMotion: '(prefers-reduced-motion: reduce)',
        },
        (context) => {
          if (context.conditions?.reduceMotion || window.scrollY > 1) {
            gsap.set(animatedItems, { clearProps: 'opacity,visibility,transform' });
            return;
          }

          let finished = false;
          let fallback = 0;
          const inputs = ['wheel', 'touchstart', 'pointerdown', 'keydown'] as const;
          const finish = () => {
            if (finished) return;
            finished = true;
            entrance.progress(1).kill();
            window.clearTimeout(fallback);
            root.classList.remove('is-entering');
            gsap.set(animatedItems, { clearProps: 'opacity,visibility,transform' });
            inputs.forEach((event) => window.removeEventListener(event, finish, true));
          };
          const entrance = gsap.timeline({ defaults: { ease: 'power3.out' }, onComplete: finish });
          root.classList.add('is-entering');
          // Opacity keeps the button interactive throughout its entrance.
          gsap.set([eyebrow, copy, scrollControl], { opacity: 0, y: 8 });
          gsap.set(lines, { yPercent: 110 });
          entrance
            .to(lines, { yPercent: 0, duration: 0.66, stagger: 0.09 }, 0)
            .to(eyebrow, { opacity: 1, y: 0, duration: 0.4 }, 0.28)
            .to(copy, { opacity: 1, y: 0, duration: 0.4 }, 0.44)
            .to(scrollControl, { opacity: 1, y: 0, duration: 0.35 }, 0.6);
          inputs.forEach((event) => window.addEventListener(event, finish, { capture: true, passive: true }));
          // Fail open even if the animation ticker is interrupted.
          fallback = window.setTimeout(finish, 1300);

          return () => {
            finish();
          };
        },
        root,
      );

      const navigateNext = () => {
        const trackController = root.closest<HTMLElement>('[data-track-controller]');
        if (trackController && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          trackController.dispatchEvent(new CustomEvent('agsit:track-next', { bubbles: true }));
          return;
        }

        root.nextElementSibling?.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
      };

      scrollControl?.addEventListener('click', navigateNext);

      window.addEventListener(
        'pagehide',
        () => {
          media.revert();
          scrollControl?.removeEventListener('click', navigateNext);
        },
        { once: true },
      );
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStrategicPlanningHeroes, { once: true });
  } else {
    initStrategicPlanningHeroes();
  }
</script>
