<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { setupContactNavigation } from './contactNavigation';
  import { setupServiceSlides } from './serviceSlidesController';

  const setupTechnologyNavigation = () => {
    const root = document.querySelector<HTMLElement>('[data-technology-local-navigation], [data-technology-solution-detail]');
    if (!root) return;

    const scroll = ScrollTrigger.getScrollFunc(window);
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('.site-nav a, .site-footer a');
      const hash = link?.getAttribute('href');
      const target = hash?.startsWith('#') ? document.getElementById(hash.slice(1)) : null;
      if (!hash || !target || !root.contains(target)) return;
      if (!target.matches('#inicio, #capacidades, [data-technology-solution-journey-step="1"]')) return;

      event.preventDefault();
      requestAnimationFrame(() => {
        let top = window.scrollY + target.getBoundingClientRect().top;
        if (target.id === 'capacidades') {
          const track = ScrollTrigger.getById('technology-capabilities-sequence') ??
            ScrollTrigger.getById('technology-capabilities-sequence-mobile');
          const margin = Number.parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
          top = track?.start ?? top - margin;
        }
        const position = Math.max(0, Math.round(top));
        if (window.location.hash !== hash) window.history.pushState(null, '', hash);
        scroll(position);
        ScrollTrigger.update();
        // Leaving Contacto can restore the previous panel during the first update.
        if (Math.abs(window.scrollY - position) > 2) {
          scroll(position);
          ScrollTrigger.update();
        }
      });
    });
  };

  const startServiceSlides = () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        setupServiceSlides();
        setupContactNavigation();
        setupTechnologyNavigation();
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startServiceSlides, { once: true });
  } else {
    startServiceSlides();
  }
</script>
