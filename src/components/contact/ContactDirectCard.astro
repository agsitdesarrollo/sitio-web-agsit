---
import type { ContactCopy } from '../../data/contact';
import { getContactInfoForPath } from '../../data/contactInfo';

type Props = {
  copy: ContactCopy['direct'];
};

const { copy } = Astro.props;
const contact = getContactInfoForPath(Astro.url.pathname);
const directionsLabel = contact.lang === 'es' ? 'Cómo llegar con Waze' : 'Get directions with Waze';
---

<aside class="contact-direct-card" aria-label={copy.label}>
  <h3>{copy.title}</h3>
  <p>{copy.copy}</p>
  <div class="contact-direct-channel">
    <a
      class="contact-direct-icon contact-direct-icon-phone"
      href={contact.whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={copy.whatsappLabel}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6.6 3.8 9 3.2a1.7 1.7 0 0 1 2 1l1.1 2.6a1.7 1.7 0 0 1-.4 1.9l-1.5 1.4a13.2 13.2 0 0 0 3.7 3.7l1.4-1.5a1.7 1.7 0 0 1 1.9-.4l2.6 1.1a1.7 1.7 0 0 1 1 2l-.6 2.4a3.4 3.4 0 0 1-3.3 2.6C9.8 20 4 14.2 4 7.1a3.4 3.4 0 0 1 2.6-3.3Z" />
      </svg>
    </a>
    <span class="contact-direct-details">
      <a class="contact-direct-primary" href={contact.whatsappHref} target="_blank" rel="noopener noreferrer">{contact.phone.display}</a>
      <span class="contact-direct-secondary">{copy.phoneLabel}</span>
    </span>
  </div>
  <div class="contact-direct-channel">
    <span class="contact-direct-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4.8 6h14.4c1 0 1.8.8 1.8 1.8v8.4c0 1-.8 1.8-1.8 1.8H4.8c-1 0-1.8-.8-1.8-1.8V7.8C3 6.8 3.8 6 4.8 6Z" />
        <path d="m4 7 8 6 8-6" />
      </svg>
    </span>
    <span class="contact-direct-details">
      <a class="contact-direct-primary" href={contact.emailHref}>{contact.email.display}</a>
    </span>
  </div>
  <div class="contact-direct-channel">
    <a
      class="contact-direct-icon"
      href={contact.wazeUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={directionsLabel}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
    </a>
    <span class="contact-direct-details">
      <a class="contact-direct-primary" href={contact.wazeUrl} target="_blank" rel="noopener noreferrer">{contact.address}</a>
      <span class="contact-direct-secondary">{directionsLabel}</span>
    </span>
  </div>
</aside>
