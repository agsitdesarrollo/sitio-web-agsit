---
import { Image } from 'astro:assets';
import logoImage from '../../assets/images/logo-asit.webp';
import type { SupportedLang } from '../../i18n/ui';
import { getAlternateLangPath, useTranslations } from '../../i18n/utils';

type Props = {
  lang: SupportedLang;
  homeHref?: string;
  servicesHref?: string;
  contactHref?: string;
  alternateHref?: string;
};

const { lang, homeHref = '#inicio', servicesHref = '#servicios', contactHref = '#contacto', alternateHref } = Astro.props;
const t = useTranslations(lang);
const alternateLangPath = alternateHref ?? getAlternateLangPath(lang);
---

<header class="site-nav">
  <a class="brand" href={homeHref} aria-label={t('nav.brandLabel')} data-nav-close>
    <Image src={logoImage} alt="AGSIT" loading="eager" fetchpriority="high" />
  </a>
  <button
    class="menu-toggle"
    type="button"
    aria-label={t('nav.openMenu')}
    aria-expanded="false"
    aria-controls="main-navigation"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav id="main-navigation">
    <a href={homeHref} data-nav-close>{t('nav.home')}</a>
    <a href={servicesHref} data-nav-close>{t('nav.services')}</a>
    <a href={contactHref} data-nav-close>{t('nav.contact')}</a>
    <a class="language-switch" href={alternateLangPath} aria-label={t('language.switchLabel')} data-nav-close>
      {t('language.switchText')}
    </a>
  </nav>
</header>
<script>
  const initializeScrollAwareHeader = () => {
    document.querySelectorAll<HTMLElement>('.site-nav').forEach((header) => {
      if (header.dataset.scrollAware === 'true') return;

      header.dataset.scrollAware = 'true';

      const mobileNavigation = header.querySelector<HTMLElement>('nav');
      let previousScrollY = Math.max(window.scrollY, 0);
      let touchStartY: number | null = null;
      let ticking = false;

      const canHide = () =>
        !mobileNavigation?.classList.contains('is-open') &&
        !document.body.classList.contains('drawer-open');

      const showHeader = () => header.classList.remove('is-scroll-hidden');
      const hideHeader = () => {
        if (canHide()) header.classList.add('is-scroll-hidden');
      };

      const respondToDirection = (direction: number) => {
        if (direction > 0) {
          hideHeader();
        } else if (direction < 0) {
          showHeader();
        }
      };

      const updateFromScroll = () => {
        const currentScrollY = Math.max(window.scrollY, 0);
        const delta = currentScrollY - previousScrollY;

        if (!canHide() || currentScrollY <= 0) {
          showHeader();
        } else if (Math.abs(delta) >= 1) {
          respondToDirection(delta);
        }

        previousScrollY = currentScrollY;
        ticking = false;
      };

      const requestScrollUpdate = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateFromScroll);
      };

      window.addEventListener(
        'wheel',
        (event) => {
          if (Math.abs(event.deltaY) < 1) return;
          respondToDirection(event.deltaY);
        },
        { passive: true },
      );
      window.addEventListener(
        'touchstart',
        (event) => {
          touchStartY = event.touches[0]?.clientY ?? null;
        },
        { passive: true },
      );
      window.addEventListener(
        'touchmove',
        (event) => {
          const currentTouchY = event.touches[0]?.clientY;
          if (touchStartY === null || currentTouchY === undefined) return;

          const delta = touchStartY - currentTouchY;
          if (Math.abs(delta) >= 4) {
            respondToDirection(delta);
            touchStartY = currentTouchY;
          }
        },
        { passive: true },
      );
      window.addEventListener('scroll', requestScrollUpdate, { passive: true });
      window.addEventListener('pageshow', () => {
        previousScrollY = Math.max(window.scrollY, 0);
        showHeader();
      });
      header.addEventListener('focusin', showHeader);

      showHeader();
    });
  };

  initializeScrollAwareHeader();
</script>
