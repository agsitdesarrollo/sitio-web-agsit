---
import ServiceExplorerPreview from '../../../components/blog/service-explorer/ServiceExplorerPreview.astro';
import type { SupportedLang } from '../../../i18n/ui';

export const prerender = true;
export function getStaticPaths() {
  return import.meta.env.DEV ? ['es', 'en'].map(lang => ({ params: { lang } })) : [];
}
const lang = Astro.params.lang as SupportedLang;
// Astro 6's automatic i18n routing otherwise treats the final /es/ segment
// as a default-locale prefix and returns the rendered preview with HTTP 404.
// This development-only document owns its language; keep shared routing intact.
if (import.meta.env.DEV) Astro.response.headers.set('X-Astro-Reroute', 'no');
---
<ServiceExplorerPreview lang={lang} />
