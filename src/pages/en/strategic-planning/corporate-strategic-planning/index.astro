---
import ContactDrawer from '../../../../components/contact/ContactDrawer.astro';
import StrategicPlanningDetailPage from '../../../../components/strategic-planning-detail/StrategicPlanningDetailPage.astro';
import Footer from '../../../../components/footer/Footer.astro';
import Header from '../../../../components/navigation/Header.astro';
import PageShellScripts from '../../../../components/navigation/PageShellScripts.astro';
import { getContactCopy } from '../../../../data/contact';
import { getStrategicPlanningDetailContent } from '../../../../data/strategicPlanningDetail';
import { getFooterCopy } from '../../../../data/footer';
import { getServicesContent } from '../../../../data/services';
import { useTranslations } from '../../../../i18n/utils';
import SiteLayout from '../../../../layouts/SiteLayout.astro';

const lang = 'en';
const content = getStrategicPlanningDetailContent('corporate-strategic-planning', lang);
const contactCopy = getContactCopy(lang);
const footerCopy = getFooterCopy(lang);
const servicesContent = getServicesContent(lang);
const t = useTranslations(lang);
const spanishHref = '/planeacion-estrategica/planeacion-estrategica-corporativa/';
---

<SiteLayout
  title={content.metadata.title}
  description={content.metadata.description}
  canonicalUrl={content.metadata.canonicalUrl}
  image={content.metadata.image}
  imageAlt={content.metadata.imageAlt}
  htmlLang={content.metadata.htmlLang}
  locale={content.metadata.locale}
  alternates={[
    { lang: 'es-MX', href: `https://agsit.com.mx${spanishHref}` },
    { lang: 'en', href: content.metadata.canonicalUrl },
    { lang: 'x-default', href: `https://agsit.com.mx${spanishHref}` },
  ]}
>
  <div class="app-shell">
    <Header
      lang={lang}
      homeHref="/en/#inicio"
      servicesHref="/en/#servicios"
      contactHref="#contacto"
      alternateHref={spanishHref}
    />
    <StrategicPlanningDetailPage content={content} contactCopy={contactCopy} />
    <Footer
      copy={footerCopy}
      services={servicesContent.services}
      homeHref="/en/#inicio"
      servicesHref="/en/#servicios"
      contactHref="#contacto"
    />
    <ContactDrawer copy={contactCopy} />
    <PageShellScripts openMenuLabel={t('nav.openMenu')} closeMenuLabel={t('nav.closeMenu')} />
  </div>
</SiteLayout>
