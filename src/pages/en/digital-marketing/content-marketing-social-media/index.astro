---
import ContactDrawer from '../../../../components/contact/ContactDrawer.astro';
import DigitalStrategyPage from '../../../../components/digital-marketing-strategy/DigitalStrategyPage.astro';
import Footer from '../../../../components/footer/Footer.astro';
import Header from '../../../../components/navigation/Header.astro';
import PageShellScripts from '../../../../components/navigation/PageShellScripts.astro';
import { getContactCopy } from '../../../../data/contact';
import { getContentMarketingSocialMediaContent } from '../../../../data/contentMarketingSocialMedia';
import { getFooterCopy } from '../../../../data/footer';
import { getServicesContent } from '../../../../data/services';
import { useTranslations } from '../../../../i18n/utils';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
const lang = 'en'; const content = getContentMarketingSocialMediaContent(lang); const contactCopy = getContactCopy(lang); const footerCopy = getFooterCopy(lang); const servicesContent = getServicesContent(lang); const t = useTranslations(lang); const spanishHref = '/marketing-digital/content-marketing-social-media/';
---
<SiteLayout title={content.metadata.title} description={content.metadata.description} canonicalUrl={content.metadata.canonicalUrl} image={content.metadata.image} imageAlt={content.metadata.imageAlt} htmlLang={content.metadata.htmlLang} locale={content.metadata.locale} alternates={[{ lang: 'es-MX', href: `https://agsit.com.mx${spanishHref}` }, { lang: 'en', href: content.metadata.canonicalUrl }, { lang: 'x-default', href: `https://agsit.com.mx${spanishHref}` }]}>
  <div class="app-shell"><Header lang={lang} homeHref="/en/#inicio" servicesHref="/en/#servicios" contactHref="#contacto" alternateHref={spanishHref} /><DigitalStrategyPage content={content} contactCopy={contactCopy} /><Footer copy={footerCopy} services={servicesContent.services} homeHref="/en/#inicio" servicesHref="/en/#servicios" contactHref="#contacto" /><ContactDrawer copy={contactCopy} /><PageShellScripts openMenuLabel={t('nav.openMenu')} closeMenuLabel={t('nav.closeMenu')} /></div>
</SiteLayout>
